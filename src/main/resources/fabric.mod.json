{
	"schemaVersion": 1,
	"id": "storage-manager",
	"version": "${version}",
	"name": "Storage Manager",
	"description": "A Baritone-powered storage bot: walks to chests to store and fetch items, controlled via a local web UI.",
	"authors": [
		"UwUtismXD"
	],
	"contact": {
		"homepage": "https://github.com/UwUtismXD/storage-manager"
	},
	"license": "CC0-1.0",
	"icon": "assets/storage-manager/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"storage.manager.StorageManager"
		],
		"client": [
			"storage.manager.client.StorageManagerClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*",
		"baritone": "*"
	}
}